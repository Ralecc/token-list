# Copy to .env and adjust. Every backend is optional except the chat model.

# Where the web app is served. Keep 127.0.0.1 unless you know you need LAN access
# (camera/mic only work on localhost or https, see README).
HOST=127.0.0.1
PORT=8787
# Extra host names allowed to reach the server, comma separated
# (e.g. your Tailscale name: mypc.tailnet-1234.ts.net).
ALLOWED_HOSTS=

# --- Brain: any OpenAI-compatible chat endpoint --------------------------------
#   Ollama     http://127.0.0.1:11434/v1
#   llama.cpp  http://127.0.0.1:8080/v1   (llama-server)
#   KoboldCpp  http://127.0.0.1:5001/v1
#   LM Studio  http://127.0.0.1:1234/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=mistral-nemo
LLM_API_KEY=
# true if the model understands images (e.g. gemma3, qwen2.5vl, llava) — lets her see you
LLM_VISION=false
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=400

# --- Voice: OpenAI-compatible /audio/speech (Kokoro-FastAPI, Speaches, LocalAI…) -
# Leave TTS_BASE_URL empty to use the browser's built-in voices instead.
TTS_BASE_URL=http://127.0.0.1:8880/v1
TTS_MODEL=kokoro
TTS_VOICE=af_heart
TTS_FORMAT=mp3
TTS_API_KEY=

# --- Hearing: OpenAI-compatible /audio/transcriptions (Speaches, LocalAI…) ------
# Leave STT_BASE_URL empty to fall back to the browser's speech recognition
# (in Chrome that sends your audio to Google — use a local Whisper for privacy).
STT_BASE_URL=http://127.0.0.1:8000/v1
STT_MODEL=Systran/faster-whisper-small
# Optional ISO code (en, de, fr…) — skips language detection
STT_LANGUAGE=
STT_API_KEY=

# Default character (file name in personas/, without .json)
PERSONA=mia
